# Local development: npm run dev (frontend 5173, API 8787)
# Production Docker/Railway: same-origin frontend and API at PORT
PORT=8787
API_RATE_LIMIT=120
CHEMPATH_DATA_DIR=data
# Optional: set frontend URL only when hosting UI separately
# VITE_API_URL=https://your-backend.example.com/api

# Optional full Open Reaction Database SQLite index (local or mounted storage)
# CHEMPATH_ORD_DB=data/ord/ord.sqlite
