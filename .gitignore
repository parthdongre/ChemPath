# Build output
engine/build/
web/dist/

# JavaScript dependencies
node_modules/

# Local environment
.env
.env.local

# OS / editor
.DS_Store
.vscode/
.idea/

# Large ORD data is downloaded/indexed locally (never commit giant datasets).
data/ord/*.sqlite
data/ord/*.sqlite-*
data/ord/cache/
data/ord-demo/
.venv/

# Full Rhea snapshots and generated graph exports stay outside Git.
data/rhea/cache/
data/rhea/full/
__pycache__/
*.pyc

# Large sourced PubChem catalog is an optional local SQLite install.
data/catalog/*.sqlite
data/catalog/*.sqlite-*
data/catalog/*.partial

# Interrupted atomic catalog imports can leave SQLite journal sidecars.
data/catalog/*.partial-*
