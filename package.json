{
  "name": "chempath",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "build:engine": "cmake -S engine -B engine/build && cmake --build engine/build",
    "test:engine": "ctest --test-dir engine/build --output-on-failure",
    "dev": "concurrently \"npm --workspace server run dev\" \"npm --workspace web run dev\"",
    "build:web": "npm --workspace web run build",
    "audit:chemistry": "node scripts/audit-chemistry.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "data:500k": "python3 scripts/import-pubchem.py --target 500000",
    "data:8m": "python3 scripts/import-pubchem.py",
    "data:sync": "python3 scripts/import-pubchem.py",
    "data:full": "python3 scripts/import-pubchem.py --all"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
